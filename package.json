{
  "name": "demo-hotel-grauson",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema pms-core/prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema pms-core/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema pms-core/prisma/schema.prisma",
    "db:push": "prisma db push --schema pms-core/prisma/schema.prisma",
    "db:seed": "tsx pms-core/seed/index.ts",
    "db:demo": "DATABASE_URL=file:./demo.db prisma migrate deploy --schema pms-core/prisma/schema.prisma && DATABASE_URL=file:./demo.db tsx pms-core/seed/index.ts",
    "db:reset": "prisma migrate reset --schema pms-core/prisma/schema.prisma --force",
    "db:studio": "prisma studio --schema pms-core/prisma/schema.prisma",
    "postinstall": "prisma generate --schema pms-core/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "pms-core/prisma/schema.prisma",
    "seed": "tsx pms-core/seed/index.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "jose": "^6.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.63.0",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
