# Local SQLite file — self-contained, no remote database required.
# Switch to PostgreSQL by changing the Prisma provider and this URL.
DATABASE_URL="file:./dev.db"

# Used to sign PMS session cookies. Generate a long random string.
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: hand the public booking bar to an external engine instead of /booking.
# NEXT_PUBLIC_BOOKING_URL=
