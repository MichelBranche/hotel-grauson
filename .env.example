# Local only. Copy to .env and fill in real values there.
# Do not commit .env, the database password, or AUTH_SECRET.

# Supabase Postgres for project hotel-grauson (eu-west-2).
# Session connection on port 5432, used by Prisma migrations.
# The Next.js client rewrites a Supabase URL to the transaction pooler on 6543
# (pgbouncer=true, connection_limit=1). DIRECT_URL is not required.
# Replace PASSWORD locally. Never commit the real password.
# If the connection reports a TLS error, append ?sslmode=require.
DATABASE_URL="postgresql://postgres:PASSWORD@db.wmtuojolspyidnhhyruc.supabase.co:5432/postgres"

# Signs PMS session cookies. Replace with a long random string.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Clean seed (npm run db:seed). Passwords are required only when that user
# does not exist yet (at least 8 characters). An existing password is left
# unchanged. Do not commit real passwords.
# Set SEED_DEVELOPER_EMAIL to the current PMS login so that account becomes DEVELOPER.
SEED_DEVELOPER_EMAIL="developer@grauson.local"
SEED_DEVELOPER_PASSWORD="replace-with-a-temporary-password"
SEED_DEVELOPER_FIRST_NAME="Developer"
SEED_DEVELOPER_LAST_NAME="Grauson"
# Property owner. Default inbox of the hotel.
SEED_OWNER_EMAIL="info@locandagrauson.it"
SEED_OWNER_PASSWORD="replace-with-a-temporary-password"
SEED_OWNER_FIRST_NAME="Locanda"
SEED_OWNER_LAST_NAME="Grauson"

# Optional: hand the public booking bar to an external engine instead of /booking.
# NEXT_PUBLIC_BOOKING_URL=

# Contact form on /contatti. Mail goes through Resend.
# RESEND_API_KEY is required for the form to send. Create it in the Resend dashboard.
# CONTACT_FROM must be a verified sender. Until the domain is verified, the default
# is Locanda Grauson <onboarding@resend.dev>, which Resend delivers only to the
# account email. Set CONTACT_TO to that inbox for a test.
# CONTACT_TO overrides the hotel inbox (info@locandagrauson.it) when you need a test address.
# RESEND_API_KEY=
# CONTACT_FROM="Locanda Grauson <info@locandagrauson.it>"
# CONTACT_TO="info@locandagrauson.it"

# Stripe Checkout for the public booking deposit. Test keys only in local .env.
# Never commit the secret or the webhook signing secret.
# NEXT_PUBLIC_APP_URL is the absolute origin used for Checkout success and cancel URLs.
# In development it falls back to http://localhost:3000 when unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=
