# Local only. Copy to .env and fill in real values there.
# Do not commit .env, the database password, or AUTH_SECRET.

# Supabase Postgres for project hotel-grauson (eu-west-2).
# Direct session connection on port 5432. Prisma uses this single URL for the
# app and for migrations, so DIRECT_URL is not required.
# Replace PASSWORD locally. Never commit the real password.
# If the connection reports a TLS error, append ?sslmode=require.
DATABASE_URL="postgresql://postgres:PASSWORD@db.wmtuojolspyidnhhyruc.supabase.co:5432/postgres"

# Signs PMS session cookies. Replace with a long random string.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Clean seed (npm run db:seed). The password is required only when the owner
# user does not exist yet. Use a temporary password of at least 8 characters
# and change it after the first login. Do not commit the real password.
SEED_OWNER_EMAIL="owner@grauson.local"
SEED_OWNER_PASSWORD="replace-with-a-temporary-password"
SEED_OWNER_FIRST_NAME="Owner"
SEED_OWNER_LAST_NAME="Grauson"

# Optional: hand the public booking bar to an external engine instead of /booking.
# NEXT_PUBLIC_BOOKING_URL=
